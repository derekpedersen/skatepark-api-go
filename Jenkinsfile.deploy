pipeline {
    agent {
        label 'build-jenkins-golang || build-golang || build-golang-stable'
    }

    triggers {
        githubPush()
    }

    options {
        skipDefaultCheckout true
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        PROJECT_DIR = '.'
    }

    stages {
        stage('Guard: allow manual deploys or tag-triggered deploys') {
            steps {
                script {
                    def isManual = !currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty()
                    def isTagBuild = env.TAG_NAME?.trim()

                    env.DEPLOY_ALLOWED = 'false'

                    if (isTagBuild) {
                        env.DEPLOY_ALLOWED = 'true'
                        echo "Tag-triggered deploy detected for ${env.TAG_NAME}."
                        return
                    }

                    if (isManual) {
                        env.DEPLOY_ALLOWED = 'true'
                        echo "Manual deploy allowed from branch ${env.BRANCH_NAME}."
                        return
                    }

                    currentBuild.description = 'Deploy skipped: run manually from any branch or use a tag build.'
                    echo 'Deploy skipped: only manual runs or tag-triggered builds are allowed.'
                }
            }
        }

        stage('Checkout') {
            when {
                expression { env.DEPLOY_ALLOWED == 'true' }
            }
            steps {
                dir("${env.PROJECT_DIR}") {
                    checkout scm
                }
            }
        }

        stage('Build') {
            when {
                expression { env.DEPLOY_ALLOWED == 'true' }
            }
            steps {
                dir("${env.PROJECT_DIR}") {
                    sh 'make build'
                }
            }
        }

        stage('Publish') {
            when {
                expression { env.DEPLOY_ALLOWED == 'true' }
            }
            steps {
                script {
                    def dockerhubCredentialsId = env.DOCKERHUB_CREDENTIALS_ID ?: 'docker-jenkins-pat'
                    withDockerRegistry([credentialsId: dockerhubCredentialsId, url: 'https://index.docker.io/v1/']) {
                        dir("${env.PROJECT_DIR}") {
                            sh 'make docker'
                            sh 'make publish'
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression { env.DEPLOY_ALLOWED == 'true' }
            }
            steps {
                script {
                    def doksKubeconfigCredentialsId = env.DOKS_KUBECONFIG_CREDENTIALS_ID ?: 'DOKS_KUBECONFIG'
                    withCredentials([
                        file(
                            credentialsId: doksKubeconfigCredentialsId,
                            variable: 'KUBECONFIG'
                        )
                    ]) {
                        dir("${env.PROJECT_DIR}") {
                            sh 'make deploy'
                        }
                    }
                }
            }
        }
    }
}
